<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MiniTime</AssemblyName>
    <RootNamespace>MiniTime.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <ProjectReference Include="..\MiniTime.Core\MiniTime.Core.csproj" />
    <ProjectReference Include="..\MiniTime.Data\MiniTime.Data.csproj" />
    <ProjectReference Include="..\MiniTime.Serial\MiniTime.Serial.csproj" />
  </ItemGroup>

  <!-- O leitor de MDB é um exe x86 (.NET Framework) separado: compila sem herdar o RuntimeIdentifier do app e copia para MdbReader\ -->
  <Target Name="CompilarLeitorMdb" AfterTargets="Build">
    <MSBuild Projects="..\MiniTime.MdbReader\MiniTime.MdbReader.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=AnyCPU" RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;TargetFramework" />
    <ItemGroup>
      <ArquivosLeitorMdb Include="..\MiniTime.MdbReader\bin\$(Configuration)\net48\MiniTime.MdbReader.exe*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArquivosLeitorMdb)" DestinationFolder="$(OutDir)MdbReader" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopiarLeitorMdbNaPublicacao" AfterTargets="Publish" DependsOnTargets="CompilarLeitorMdb">
    <ItemGroup>
      <ArquivosLeitorMdbPub Include="..\MiniTime.MdbReader\bin\$(Configuration)\net48\MiniTime.MdbReader.exe*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArquivosLeitorMdbPub)" DestinationFolder="$(PublishDir)MdbReader" SkipUnchangedFiles="true" />
  </Target>
</Project>
