<UserControl x:Class="MiniTime.App.Views.ColetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Titulo}" Text="Coleta / Monitoração"/>
        <Border Grid.Row="1" Background="#FFF4D6" BorderBrush="#E0B84C" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Text="Recurso EXPERIMENTAL: o protocolo do relógio foi reconstruído a partir do programa antigo e ainda precisa ser validado com o equipamento. Marque “Mostrar tráfego” para registrar os bytes trocados e, se algo não funcionar, use esse registro para ajustar o protocolo."/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Rotulo}" Text="Porta:"/>
            <ComboBox x:Name="CmbPorta" Width="110" IsEditable="True"/>
            <Button Margin="6,0,18,0" Content="Atualizar" MinWidth="0" Click="BtnAtualizarPortas_Click"/>
            <TextBlock Style="{StaticResource Rotulo}" Text="Relógio nº:"/>
            <TextBox x:Name="TxtEndereco" Width="50" Margin="0,0,18,0"/>
            <TextBlock Style="{StaticResource Rotulo}" Text="Velocidade:"/>
            <TextBlock x:Name="TxtVelocidade" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button x:Name="BtnColetar" Style="{StaticResource BotaoPrimario}" Content="Coletar" Click="BtnColetar_Click"/>
            <Button x:Name="BtnCancelar" Content="Cancelar" IsEnabled="False" Click="BtnCancelar_Click"/>
            <CheckBox x:Name="ChkTrafego" Content="Mostrar tráfego (hex)" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True"/>
        </StackPanel>
        <DataGrid x:Name="GridColetadas" Grid.Row="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cartão" Binding="{Binding CartaoCurto}" Width="90"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Data/hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,8,0,4">
            <ProgressBar x:Name="Barra" Height="14" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="TxtStatus" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBox x:Name="TxtTrafego" Grid.Row="5" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
